              "email": {
                "type": "string"
              },
              "folder": {
                "type": "string"
              }
            }
          }
        ]
      },
      "OneDriveSourceInfo": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/SourceInfo"
          },
          {
            "type": "object",
            "properties": {
              "email": {
                "type": "string"
              },
              "folder": {
                "type": "string"
              }
            }
          }
        ]
      },
      "PageableObject": {
