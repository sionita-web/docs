      "UploadSourceInfo": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/SourceInfo"
          },
          {
            "type": "object",
            "properties": {
              "userId": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "userName": {
                "type": "string"
              }
            }
          }
        ]
      },
      "CustomOrderProperty": {
        "type": "object",
        "properties": {
          "parentIndex": {
            "type": "integer",
            "format": "int32"
          },
          "fieldIndex": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Field": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "field id",
            "example": "605c644cbf48241234f62121"
          },
          "name": {
            "type": "string",
            "description": "field name",
            "example": "Field Name"
          },
          "type": {
            "type": "string",
            "description": "field type",
            "example": "TEXT"
          },
          "value": {
            "type": "object",
            "description": "field value"
          },
          "metadata": {
            "$ref": "#/components/schemas/PublicApiMatchedFieldMetadataDto"
          }
        }
