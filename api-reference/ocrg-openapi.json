                "$ref": "#/components/schemas/FaxSourceInfo"
              },
              {
                "$ref": "#/components/schemas/GDriveSourceInfo"
              },
              {
                "$ref": "#/components/schemas/OneDriveSourceInfo"
              },
              {
                "$ref": "#/components/schemas/SiteReaderSourceInfo"
              },
              {
                "$ref": "#/components/schemas/StudioSourceInfo"
              },
              {
                "$ref": "#/components/schemas/UploadSourceInfo"
              }
            ]
          },
          "author": {
            "type": "string"
          }
        }
