          "ascending": {
            "type": "boolean"
          },
          "property": {
            "type": "string"
          },
          "ignoreCase": {
            "type": "boolean"
          }
        }
      },
      "SourceInfo": {
        "type": "object",
        "properties": {
          "sourceType": {
            "type": "string",
            "enum": [
              "API",
              "EMAIL",
              "UPLOAD",
